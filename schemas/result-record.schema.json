{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pwnzzai-garak/result-record.schema.json",
  "title": "Normalized PwnzzAI Attempt Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "run_id",
    "attempt_id",
    "test_case_id",
    "repetition",
    "started_at",
    "duration_ms",
    "target",
    "request",
    "response",
    "automatic_label",
    "manual_label",
    "evidence",
    "state"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,80}$" },
    "attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{3,120}$" },
    "test_case_id": { "type": "string" },
    "repetition": { "type": "integer", "minimum": 1 },
    "retry_of": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "base_url", "pwnzzai_commit", "ollama_version", "model", "model_digest"],
      "properties": {
        "system": { "const": "pwnzzai" },
        "base_url": { "type": "string", "format": "uri" },
        "pwnzzai_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "ollama_version": { "type": "string" },
        "model": { "type": "string" },
        "model_digest": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "content_type", "input_artifact_sha256", "sanitized_body"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/" },
        "content_type": { "type": "string" },
        "input_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sanitized_body": {}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_code", "normalized_output", "raw_evidence_sha256"],
      "properties": {
        "status_code": { "type": "integer", "minimum": 100, "maximum": 599 },
        "normalized_output": { "type": "string" },
        "raw_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "application_metadata": { "type": "object" }
      }
    },
    "automatic_label": {
      "$ref": "#/$defs/label"
    },
    "manual_label": {
      "oneOf": [
        { "$ref": "#/$defs/label" },
        { "type": "null" }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_path", "normalized_path"],
      "properties": {
        "raw_path": { "type": "string" },
        "normalized_path": { "type": "string" },
        "input_path": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_id", "after_id", "reset_applied"],
      "properties": {
        "before_id": { "type": "string" },
        "after_id": { "type": "string" },
        "reset_applied": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "enum": ["success", "failure", "ambiguous", "error"] },
        "reason": { "type": "string", "minLength": 1 },
        "detector_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}

