{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pwnzzai-garak/test-case.schema.json",
  "title": "PwnzzAI Security Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_case_id",
    "title",
    "category",
    "family",
    "objective",
    "policy_id",
    "surface",
    "input_artifact",
    "expected_secure_behavior",
    "automatic_detector_ids",
    "manual_rule",
    "state",
    "repetitions",
    "stop_conditions",
    "owasp",
    "provenance",
    "inference_parameters",
    "pilot_selected"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "test_case_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "title": { "type": "string", "minLength": 3 },
    "category": {
      "enum": [
        "direct_prompt_injection",
        "indirect_prompt_injection",
        "information_disclosure",
        "data_poisoning",
        "control"
      ]
    },
    "family": { "type": "string", "minLength": 2 },
    "objective": { "type": "string", "minLength": 10 },
    "policy_id": { "enum": ["PI-01", "SD-01", "SP-01", "DI-01"] },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "content_type"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/" },
        "content_type": { "type": "string" }
      }
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["text", "json", "qr_png", "multipart", "dataset"] },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "expected_secure_behavior": { "type": "string", "minLength": 5 },
    "automatic_detector_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "manual_rule": { "type": "string", "minLength": 10 },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "prerequisites", "reset"],
      "properties": {
        "classification": {
          "enum": [
            "stateless",
            "session_scoped",
            "database_mutating",
            "rag_mutating",
            "model_state_producing",
            "filesystem_mutating"
          ]
        },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "reset": { "type": "string", "minLength": 2 }
      }
    },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "control_type": {
      "enum": ["benign", "positive", "zero_poison"]
    },
    "parameters": {
      "type": "object"
    },
    "inference_parameters": {
      "type": "object",
      "minProperties": 1
    },
    "pilot_selected": { "type": "boolean" },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "owasp": {
      "type": "array",
      "items": { "enum": ["LLM01:2025", "LLM02:2025", "LLM04:2025", "LLM07:2025"] },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  }
}
