{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pwnzzai-garak/experiment-config.schema.json",
  "title": "Experiment Protocol Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "principal_target",
    "categories",
    "controls",
    "execution",
    "scenario_catalog",
    "prompt_inference",
    "poisoning",
    "pilot",
    "manual_review",
    "safety",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "principal_target": {
      "type": "object",
      "required": ["system", "base_url", "pwnzzai_commit", "model", "model_digest"],
      "properties": {
        "system": { "const": "pwnzzai" },
        "base_url": { "type": "string", "format": "uri" },
        "pwnzzai_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "model": { "type": "string" },
        "model_digest": { "type": "string" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 4,
      "items": {
        "enum": [
          "direct_prompt_injection",
          "indirect_prompt_injection",
          "information_disclosure",
          "data_poisoning"
        ]
      },
      "uniqueItems": true
    },
    "controls": {
      "type": "object",
      "required": ["benign_per_surface", "positive_controls", "state_reset_required"],
      "properties": {
        "benign_per_surface": { "type": "integer", "minimum": 1 },
        "positive_controls": { "type": "boolean" },
        "state_reset_required": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["repetitions", "timeout_seconds", "max_retries", "max_total_attempts"],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_total_attempts": { "type": "integer", "minimum": 1 },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "scenario_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "case_count"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "case_count": { "type": "integer", "minimum": 1 }
      }
    },
    "prompt_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "seed",
        "stream",
        "keep_alive",
        "timeout_seconds",
        "automatic_retries"
      ],
      "properties": {
        "temperature": { "type": ["number", "string"] },
        "seed": { "type": ["integer", "string", "null"] },
        "stream": { "type": "boolean" },
        "keep_alive": { "type": "integer" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "automatic_retries": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "poisoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_path",
        "holdout_sha256",
        "holdout_sample_count",
        "target_sample_id",
        "target_expected_label",
        "target_direction",
        "targeted_budgets",
        "broad_budgets",
        "minimum_baseline_accuracy",
        "accuracy_degradation_threshold",
        "prediction_flip_rate_threshold",
        "rollback"
      ],
      "properties": {
        "holdout_path": { "type": "string" },
        "holdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "holdout_sample_count": { "type": "integer", "minimum": 1 },
        "target_sample_id": { "type": "string" },
        "target_expected_label": { "enum": ["positive", "negative"] },
        "target_direction": { "enum": ["positive", "negative"] },
        "targeted_budgets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "broad_budgets": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "minimum_baseline_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "accuracy_degradation_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "prediction_flip_rate_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "rollback": { "type": "string", "minLength": 10 },
        "baseline_regeneration_per_budget": { "type": "boolean" },
        "requests_per_baseline_or_budget": { "type": "integer", "minimum": 1 }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "selected_case_ids",
        "prompt_repetitions_per_case",
        "max_target_requests",
        "max_wall_clock_seconds",
        "max_upload_bytes",
        "max_poison_samples",
        "max_requests_per_second",
        "max_concurrency",
        "error_stop_threshold"
      ],
      "properties": {
        "authorized": { "type": "boolean" },
        "selected_case_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "prompt_repetitions_per_case": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_target_requests": { "type": "integer", "minimum": 1 },
        "max_wall_clock_seconds": { "type": "integer", "minimum": 1 },
        "max_upload_bytes": { "type": "integer", "minimum": 1 },
        "max_poison_samples": { "type": "integer", "minimum": 0 },
        "max_requests_per_second": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_concurrency": { "const": 1 },
        "error_stop_threshold": { "type": "integer", "minimum": 1 }
      }
    },
    "manual_review": {
      "type": "object",
      "required": ["review_all_hits", "review_all_ambiguous", "non_hit_sample_rate"],
      "properties": {
        "review_all_hits": { "const": true },
        "review_all_ambiguous": { "const": true },
        "non_hit_sample_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "sampling_seed": { "type": "integer" }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "authorized_local_lab",
        "allow_attack_execution",
        "allow_full_execution",
        "authorization_scope",
        "prohibited_actions"
      ],
      "properties": {
        "authorized_local_lab": { "const": true },
        "allow_attack_execution": { "type": "boolean" },
        "allow_full_execution": { "const": false },
        "authorization_scope": { "enum": ["none", "phase5_pilot_only"] },
        "prohibited_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_append_only",
        "normalized_jsonl",
        "hash_algorithm",
        "automatic_manual_separate",
        "external_upload"
      ],
      "properties": {
        "raw_append_only": { "const": true },
        "normalized_jsonl": { "const": true },
        "hash_algorithm": { "const": "sha256" },
        "automatic_manual_separate": { "const": true },
        "external_upload": { "const": false }
      }
    }
  }
}
