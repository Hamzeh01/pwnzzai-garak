{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pwnzzai-garak/risk-record.schema.json",
  "title": "Finding and Risk Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "title",
    "policy_id",
    "owasp",
    "evidence",
    "likelihood",
    "impact",
    "risk_score",
    "rating",
    "mitigations",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "finding_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 5 },
    "policy_id": { "enum": ["PI-01", "SD-01", "SP-01", "DI-01"] },
    "owasp": {
      "type": "array",
      "items": { "enum": ["LLM01:2025", "LLM02:2025", "LLM04:2025", "LLM07:2025"] },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 },
    "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
    "risk_score": { "type": "integer", "minimum": 1, "maximum": 25 },
    "rating": { "enum": ["low", "medium", "high", "critical"] },
    "mitigations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

