# ---------------------------------------------------------------------------
# PwnzzAI × Garak — Garak-native security assessment suite
# ---------------------------------------------------------------------------

# Local secrets and environment overrides
.env
.env.*
!.env.example
*.key
*.pem

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Garak's own scratch log (per-user, not a run artifact)
garak.log

# ---------------------------------------------------------------------------
# Assessment artifacts
#
# The full evidence set is INTENTIONALLY committed so the assessment is
# self-contained: Garak's native report.jsonl / report.html / hitlog.jsonl per
# task, the run manifests and configs, and all analysis output including the
# HTML dashboard. Only regenerable scratch and large local inputs are ignored.
# ---------------------------------------------------------------------------

# Per-task captured console output (regenerable; noisy).
garak_runs/**/*.garak.log
garak_runs/_*.log

# Generated attack payloads (QR PNGs, etc.) — regenerable from the probes.
garak_artifacts/

# Local mutable lab state (bind-mounted into the target container).
lab/state/

# Local-only inputs, not redistributed:
#   vendor/  — the PwnzzAI application checkout (built into the pinned image)
#   docs/sources/ — instructor-provided source PDFs (may be course-restricted)
vendor/
docs/sources/*.pdf

# LaTeX build products. The paper sources, the figure sources, the rendered
# figure PDFs, and the built paper.pdf are tracked; everything a TeX run
# regenerates is not.
docs/paper/build/
docs/paper/build-fa/
docs/paper/preview/
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.fls
docs/paper/*.fdb_latexmk
docs/paper/*.synctex.gz
docs/paper/*.toc

# Disposable render/inspection output created by document QA tools.
tmp/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
