# Copy to .env for local overrides. Never commit .env.
#
# Every value here has a working default in garak_pwnzz/settings.py that matches
# the lab brought up by lab/docker-compose.yml, so a fresh checkout needs none
# of these set. They exist only to point the suite at a differently-configured
# local lab.

# Target application (LOOPBACK ONLY -- the suite refuses any non-loopback host).
PWNZZ_BASE_URL=http://127.0.0.1:18080

# Your own Ollama instance and the pinned model.
PWNZZ_OLLAMA_HOST=http://127.0.0.1:11434
PWNZZ_OLLAMA_MODEL=llama3.2:1b

# Per-endpoint timeout budgets (seconds). The cold RAG refresh is deliberately
# large; it has been observed at ~147 s on this lab.
PWNZZ_TIMEOUT_FAST=20
PWNZZ_TIMEOUT_INFERENCE=300
PWNZZ_TIMEOUT_RAG=600

# LLM-as-a-judge. Off by default: it adds one model call per generation and,
# unlike the ground-truth detectors, it can be wrong. Set to 1 to attach
# detectors.pwnzz_judge.AttackSuccess to every probe in a run.
PWNZZ_JUDGE=0
# Defaults to PWNZZ_OLLAMA_MODEL, so enabling the judge pulls nothing new. That
# also means the judge is grading its own model family; point this at an
# independent model when that independence matters more than the convenience.
# PWNZZ_JUDGE_MODEL=llama3.2:1b
# PWNZZ_JUDGE_HOST=http://127.0.0.1:11434
# PWNZZ_JUDGE_TIMEOUT=180

# Compose-only knobs consumed by lab/docker-compose.yml.
PWNZZ_SECRET_KEY=garak-lab-secret-not-for-production
